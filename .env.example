# Copy this file to .env and adjust the values.
# `flask run` loads .env automatically through python-dotenv; a WSGI server
# does not, so export these variables in the process environment instead.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# SQLAlchemy connection string. The driver is PyMySQL.
# URL-encode any special characters in the password (for example @ as %40).
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/school_db

# Signs the session cookie and the CSRF tokens. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The application refuses to start in production without this.
SECRET_KEY=change-me-to-a-long-random-string

# development, testing or production.
FLASK_ENV=development

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Name shown in the navigation bar and on printed report cards.
SCHOOL_NAME=Greenfield Public School

# Rows per page in the student list. Default: 25
ITEMS_PER_PAGE=25

# Root logging level: DEBUG, INFO, WARNING, ERROR or CRITICAL. Default: INFO
LOG_LEVEL=INFO

# Set to 1 to echo every SQL statement in development. Default: off
SQLALCHEMY_ECHO=0

# Connection string used by the test suite. Defaults to in-memory SQLite, so
# the tests run without a MySQL server.
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
